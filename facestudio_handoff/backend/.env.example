# Copy to .env (or set as real environment variables). Never commit the filled-in file.

# RunPod: API key with access to the Face Studio endpoint, and the endpoint id.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=kgcsaw0mpwbz4c

# S3-compatible storage (Cloudflare R2 here). Must be the SAME bucket the RunPod
# endpoint writes results to; inputs are uploaded here for the worker to fetch.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=video-api
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_INPUT_PREFIX=facestudio/input
# Must equal the endpoint's OUTPUT_S3_PREFIX.
S3_OUTPUT_PREFIX=facestudio/output

# Optional: serve the page from this server too, so app.js keeps API_BASE = "".
# SITE_DIR=../faceswap

# Optional: only if the page is on a different origin than this API,
# e.g. https://www.yourdomain.com  (comma-separated)
# CORS_ORIGINS=
