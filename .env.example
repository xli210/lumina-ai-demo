# =============================================================================
# NanoPocket - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# =============================================================================

# --- Supabase ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe ---
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Get this from: https://dashboard.stripe.com/webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Product installer downloads (Cloudflare R2) ---
# Installers are served from R2 via short-lived presigned URLs minted by
# /api/downloads/[filename]. Set all three to enable it; leave them unset and
# that route falls back to Supabase Storage.
#
# R2 rather than Supabase Storage because egress is free. Supabase allows
# 5 GB/month on the free plan and 250 GB on Pro, and one installer here is
# 114 MB — 44 downloads would exhaust the free allowance. The free plan also
# caps a single file at 50 MB, which silently excluded the three largest
# installers.
# See docs/downloads-r2.md
R2_DOWNLOADS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_DOWNLOADS_ACCESS_KEY_ID=
R2_DOWNLOADS_SECRET_ACCESS_KEY=
# Optional; these are the defaults.
# R2_DOWNLOADS_BUCKET=video-api
# R2_DOWNLOADS_PREFIX=downloads
# R2_DOWNLOADS_REGION=auto

# --- Face Studio face-swap gateway ---
# Shared secret between this app and the Face Studio gateway (the FastAPI
# service in facestudio-gateway/, deployed separately). The gateway holds the
# RunPod key and the R2 credentials, so this token is the only thing stopping
# an anonymous caller from spending GPU money directly. Generate with
#   openssl rand -hex 32
# and set the SAME value on both sides.
# See docs/face-studio.md
FACESTUDIO_GATEWAY_TOKEN=
# Optional override; defaults to https://facestudio-gateway.onrender.com
# FACESTUDIO_BASE_URL=https://facestudio-gateway.onrender.com

# --- VSR-Pro video-upscale gateway ---
# Server-side secret. The API doc is explicit that this must never reach the
# browser, so it is only ever read by lib/vsrpro-server.ts, which injects the
# Bearer header on the /api/vsrpro/* proxy routes.
# See docs/vsr-pro-api.zh-CN.md
VSRPRO_API_KEY=sk_live_xxxxxxxxxxxx
# Optional override; defaults to https://vsrpro-gateway.onrender.com
# VSRPRO_BASE_URL=https://vsrpro-gateway.onrender.com

# --- Site URL ---
# The public URL of your deployed site (no trailing slash)
# Used for Supabase auth redirects and Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: Dev override for Supabase redirect ---
# Only set this if you need a different redirect URL in development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/account

# =============================================================================
# Search-engine & LLM verification codes (GEO)
# =============================================================================
# Each of these is the per-engine site-verification token issued by the
# corresponding webmaster console. Setting one activates the matching <meta>
# tag in <head> at build time; leaving it unset is a safe no-op.
#
# Where to get each token:
#   Google Search Console: https://search.google.com/search-console
#   Bing Webmaster Tools:  https://www.bing.com/webmasters/
#   Baidu Ziyuan:          https://ziyuan.baidu.com/
#   360 Webmaster:         https://zhanzhang.so.com/
#   Sogou Webmaster:       https://zhanzhang.sogou.com/
#   Naver Search Advisor:  https://searchadvisor.naver.com/
#   Yandex Webmaster:      https://webmaster.yandex.com/
#   Yahoo Site Explorer:   (legacy — only if needed)
#   Pinterest Domain:      https://www.pinterest.com/business/claim/
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
# NEXT_PUBLIC_360_SITE_VERIFICATION=
# NEXT_PUBLIC_SOGOU_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
# NEXT_PUBLIC_YAHOO_SITE_VERIFICATION=
# NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=

# --- IndexNow (Bing + Yandex + Naver auto-discovery) ---
# Generate a 32-character hex key (e.g. `openssl rand -hex 16`) and host it at
# https://nanopocket.ai/<key>.txt with the key as the file body. Then ping
# https://api.indexnow.org/indexnow?url=...&key=... whenever a URL changes.
# Used by scripts/indexnow.mjs.
# INDEXNOW_KEY=

