# HeadSwap Pro (headswap-pro) gateway settings. On Render: set these in the dashboard (Environment). Locally: set them as environment
# variables before starting uvicorn. Values marked "secret" are sent to you separately - never commit them.

# --- RunPod (secret: RUNPOD_API_KEY)
RUNPOD_API_KEY=rpa_xxx
RUNPOD_ENDPOINT_ID=0yecvjeuqqfoyo

# --- Cloudflare R2 storage (secret: the two keys)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=video-api

# --- Watermark. HS_ENTITLEMENT_SECRET (secret) must be the same value as on the website backend.
# HS_WATERMARK_MODE: credits (default: never bought credits -> watermark) | always | never
HS_ENTITLEMENT_SECRET=xxx
HS_WATERMARK_MODE=credits
# 1 = a swap needs the site's signed ticket (credits reserved first). Leave on in production.
HS_TICKET_REQUIRED=1

# --- Logs. HS_ADMIN_KEY (secret) protects GET /api/admin/logs (header X-HS-Admin-Key).
HS_ADMIN_KEY=xxx
HS_LOG_PREFIX=headswap/logs/gateway

# --- Optional
# Allowed page origins, comma separated
HS_CORS_ORIGINS=https://nanopocket.ai
# Where uploaded photos go in R2
HS_INPUT_PREFIX=headswap/input
# Per client IP, per hour
HS_SWAPS_PER_HOUR=30
HS_PHOTOS_PER_HOUR=60
# Direct uploads: how long a presigned upload link works, and the per-IP hourly limit on issuing them.
# File uploads through this server are refused while HS_TICKET_REQUIRED=1 unless HS_ALLOW_FILE_UPLOADS=1.
HS_UPLOAD_TTL=600
HS_UPLOADS_PER_HOUR=120
# Seconds an uploaded photo stays usable
HS_PHOTO_TTL=10800
