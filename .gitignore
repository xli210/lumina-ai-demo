*.exe
# Exception: distribution installers under downloads-private/ are the
# whole point of that folder and are LFS-tracked (see .gitattributes).
!downloads-private/*.exe

# Desktop app secrets & runtime files (never commit)
.license
.machine_lock
.download_status
.hf_download_cache/
# Anchor /image/ and /video/ to the repo root so we don't accidentally
# ignore product page subdirectories like /apps/nano-faceswap-pro/video.
/image/
/video/

# Source content drafts (kept local only)
New features.docx
demo 2/
# Raw frontend handoff (140 MB of PNGs). The runtime copy lives under
# public/private-demos/ (WebP-optimized). The handoff is kept local as
# source input for scripts/convert-face-templates.mjs only.
site_handoff 2/

# Face Studio handoff: the original 6.8 MB PNG face templates.
#
# The same 13 images are already in the repo as 2.2 MB of WebP under
# public/face-studio/face_templates/, which is what the console actually
# serves. Committing the PNGs would add 81 MB for no benefit, and
# next.config.mjs already has to exclude downloads-private/ to stay under
# the 250 MB Vercel Lambda limit. The rest of the handoff is committed,
# because docs/face-studio.md cites it.
facestudio_handoff/faceswap/face_templates/

# Handoff bundle. Contains plaintext production credentials and is assembled
# for download only. THIS REPO IS PUBLIC — committing this directory would
# publish every key in it. Regenerate with scripts/build-handoff-bundle.sh.
_handoff/
_handoff.zip
_bundles/

# One-off license recovery input: customer emails and account ids
scripts/.backfill-payments.json

# Image edit studio package (cloud image editor). It holds code shared with the
# GPU worker and 12 CC BY-SA sample photos. THIS REPO IS PUBLIC: deploy it from a
# private repo, never from here.
image-edit-studio*.zip
image-edit-studio/
