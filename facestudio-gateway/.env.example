# Face Studio gateway settings. Copy to .env locally, or set these as
# environment variables in Render. Never commit the filled-in file.

# The shared secret between nanopocket.ai and this service. Generate with
#   openssl rand -hex 32
# and set the SAME value as FACESTUDIO_GATEWAY_TOKEN in the Vercel project.
# This service holds the RunPod and R2 keys, so an unauthenticated caller
# could spend GPU money directly; the token is the only thing preventing that.
FACESTUDIO_GATEWAY_TOKEN=

# RunPod: an API key with access to the Face Studio endpoint, and the endpoint id.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=kgcsaw0mpwbz4c

# S3-compatible storage (Cloudflare R2). Must be the SAME bucket the RunPod
# endpoint writes results to; inputs are uploaded here for the worker to fetch.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=video-api
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_INPUT_PREFIX=facestudio/input
# Must equal the endpoint's OUTPUT_S3_PREFIX.
S3_OUTPUT_PREFIX=facestudio/output
